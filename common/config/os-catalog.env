# os-catalog.env — the operating systems this repo can plan for, with
# latest-release pins and media/verification facts. Bump pins deliberately;
# the plan script's release checks report drift. OS-level facts live here
# (single source of truth); device-only pins stay in each device's
# config/versions.env.

OS_CATALOG="ubuntu qubes pureos rocky rhel windows-11-pro windows-11-home"

# --- Ubuntu (the LTS target of the Raider and MacBook pairs) ----------------
UBUNTU_VERSION="26.04"

# --- Qubes OS ---------------------------------------------------------------
# ISO verified via its detached .asc by the release signing key, which must
# itself carry a good signature from the Qubes Master Signing Key.
QUBES_VERSION="4.3.1"
QUBES_ISO_DIR_URL="https://mirrors.edge.kernel.org/qubes/iso"
QUBES_MASTER_KEY_URL="https://keys.qubes-os.org/keys/qubes-master-signing-key.asc"
QUBES_RELEASE_KEY_URL="https://keys.qubes-os.org/keys/qubes-release-4.3-signing-key.asc"
QUBES_MASTER_KEY_FPR="427F11FD0FAA4B080123F01CDDFA1A3E36879494"

# --- PureOS -----------------------------------------------------------------
# Purism publishes NO GPG signatures for these ISOs — only SHA256/BLAKE2
# checksum files over HTTPS; verified against the sha256 pinned here AND the
# published checksum file.
PUREOS_VERSION="11"
PUREOS_CODENAME="crimson"
PUREOS_RELEASE_DIR="2026.05"
PUREOS_IMAGE="pureos-11-gnome-live-20260515_amd64.iso"
PUREOS_DL_BASE_URL="https://storage.puri.sm/pureos/images/crimson/2026.05/gnome"
PUREOS_IMAGES_ROOT_URL="https://storage.puri.sm/pureos/images/crimson"
PUREOS_ISO_SHA256="2d27e60b22ffa5a336118817dc4b24a27faa303261768d3634ea4d5ec83b6365"

# --- Rocky Linux ------------------------------------------------------------
# Latest stable as of 2026-08 (10.2 GA 2026-05-28). ISOs live under
# <root>/<major>/isos/x86_64/ with stable Rocky-<major>-latest-* names;
# the CHECKSUM file there is SHA256 + a DETACHED GPG signature (.asc) by
# the Rocky release key pinned below. EL10 guidance: /boot >= 2 GiB.
ROCKY_VERSION="10.2"
ROCKY_MAJOR="10"
ROCKY_ISO_ROOT_URL="https://download.rockylinux.org/pub/rocky"
ROCKY_GPG_KEY_URL="https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-Rocky-10"
ROCKY_GPG_KEY_FPR="FC226859C0860BF0DDB95B085B106C736FEDFC85"

# --- Red Hat Enterprise Linux ----------------------------------------------
# Latest GA as of 2026-08 (10.2, GA 2026-05-19; 9.x line at 9.8). ISOs
# require a Red Hat login (customer subscription or the no-cost Developer
# Subscription, 16 systems) — there is no unauthenticated official media
# channel; the release check only DETECTS the latest version from Red Hat's
# public release-dates article.
RHEL_VERSION="10.2"
RHEL_RELEASES_URL="https://access.redhat.com/articles/red-hat-enterprise-linux-release-dates"

# --- Microsoft Windows 11 (Pro and Home) ------------------------------------
# Latest broadly-available GA as of 2026-08: 25H2 (build 26200). One
# multi-edition ISO covers Pro and Home (edition selected by product key or
# EI.cfg); Microsoft publishes SHA256 hashes on the download page, but the
# generated links expire after 24 hours — media download is a manual step.
# Note: silicon-targeted versions (e.g. 26H1, new-device-only) appear on the
# release-health page without ever reaching the consumer channel — the
# release check flags but does not trust them.
WIN11_VERSION="25H2"
WIN11_DOWNLOAD_URL="https://www.microsoft.com/software-download/windows11"
WIN11_RELEASE_INFO_URL="https://learn.microsoft.com/windows/release-health/windows11-release-information"
