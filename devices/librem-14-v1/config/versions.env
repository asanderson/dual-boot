# versions.env — pinned versions for repeatable installs.
# Bump deliberately (the script's release check reports drift), then re-run.

# Qubes OS: latest stable as of 2026-08 (released 2026-06-11). The ISO is
# verified via its detached .asc made by the release signing key, which must
# itself carry a good signature from the Qubes Master Signing Key (pinned
# fingerprint below) — the chain of trust from the Qubes docs.
QUBES_VERSION="4.3.1"
QUBES_ISO_DIR_URL="https://mirrors.edge.kernel.org/qubes/iso"
QUBES_MASTER_KEY_URL="https://keys.qubes-os.org/keys/qubes-master-signing-key.asc"
QUBES_RELEASE_KEY_URL="https://keys.qubes-os.org/keys/qubes-release-4.3-signing-key.asc"
QUBES_MASTER_KEY_FPR="427F11FD0FAA4B080123F01CDDFA1A3E36879494"

# PureOS: latest stable as of 2026-08 — PureOS 11 "Crimson" (tracks Debian 12
# Bookworm; 2026.05 images). Purism publishes NO GPG signatures for these
# ISOs, only SHA256/BLAKE2 checksum files over HTTPS — so the ISO is checked
# against the sha256 pinned here AND the published checksum file.
PUREOS_VERSION="11"
PUREOS_CODENAME="crimson"
PUREOS_RELEASE_DIR="2026.05"
PUREOS_IMAGE="pureos-11-gnome-live-20260515_amd64.iso"
PUREOS_DL_BASE_URL="https://storage.puri.sm/pureos/images/crimson/2026.05/gnome"
PUREOS_IMAGES_ROOT_URL="https://storage.puri.sm/pureos/images/crimson"
PUREOS_ISO_SHA256="2d27e60b22ffa5a336118817dc4b24a27faa303261768d3634ea4d5ec83b6365"

# PureBoot / Librem EC firmware — checked and REPORTED only, never flashed
# by the script. The latest-release lookup reads the PUREBOOT_VERSION_14 pin
# straight out of Purism's own flashing utility (the vendor's source of
# truth for what ships on the Librem 14). Installed version appears in
# /sys/class/dmi/id/bios_version as "PureBoot-<release>". EC updates ship as
# a dedicated boot ISO (librem_14/Librem_14_EC_Update.iso in the releases
# repo); installed EC version via Purism's purism_ectool.
PUREBOOT_VERSION="Release-30.1"
LIBREM_EC_VERSION="1.14"
PUREBOOT_UTIL_URL="https://source.puri.sm/firmware/utility/raw/master/coreboot_util.sh"

# Disk layout for the clean dual install (2TB NVMe): ONE shared unencrypted
# /boot (PureBoot/Heads tracks a single /boot device and signs its contents;
# per Purism, dual boot reuses one /boot — switching boot devices is fragile)
# plus one LUKS partition per OS.
TARGET_DISK_DEFAULT="/dev/nvme0n1"
BOOT_GIB="2"
QUBES_LUKS_GIB="1000"
