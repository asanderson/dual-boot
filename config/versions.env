# versions.env — pinned versions for repeatable installs.
# Bump deliberately, then re-run the affected script.

# NVIDIA driver branch fallback if `ubuntu-drivers` cannot recommend one.
# R595 is the current production branch (595.58.03+, lists the RTX 5090
# Laptop GPU as supported); 580 is the previous production branch.
NVIDIA_DRIVER_BRANCH="595"
